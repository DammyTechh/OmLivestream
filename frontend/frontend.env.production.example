# ── Frontend Production .env for Vercel ─────────────────────────────
# Set these as Environment Variables in your Vercel project (frontend).
# Dashboard → Your Project → Settings → Environment Variables

# Your deployed backend URL
NEXT_PUBLIC_API_URL=https://your-backend.vercel.app/api/v1

# For Socket.io (real-time comments/viewers) — same backend URL
NEXT_PUBLIC_SOCKET_URL=https://your-backend.vercel.app

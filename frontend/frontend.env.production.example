# ══════════════════════════════════════════════════════════════════════
#  OmliveStream — Frontend Production Environment for Vercel
#  Set these in Vercel → Project → Settings → Environment Variables.
#  All NEXT_PUBLIC_* values are inlined into the client bundle at BUILD
#  time, so you must redeploy after changing any of them.
#  No spaces around "=". A stray space becomes part of the value.
# ══════════════════════════════════════════════════════════════════════

# ── Backend ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.omlivestream.com/api/v1
NEXT_PUBLIC_SOCKET_URL=https://api.omlivestream.com

# ── App surfaces ────────────────────────────────────────────────────
# Only used for links that cross a subdomain boundary. Navigation within
# a surface stays relative so client-side routing keeps working.
NEXT_PUBLIC_SITE_URL=https://www.omlivestream.com
NEXT_PUBLIC_DASHBOARD_URL=https://dashboard.omlivestream.com
NEXT_PUBLIC_ADMIN_URL=https://admin.omlivestream.com
NEXT_PUBLIC_PAYMENT_URL=https://payment.omlivestream.com

# ── Official contact addresses ──────────────────────────────────────
NEXT_PUBLIC_SUPPORT_EMAIL=support@omlivestream.com
NEXT_PUBLIC_SALES_EMAIL=sales@omlivestream.com


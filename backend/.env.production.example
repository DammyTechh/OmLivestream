# ════════════════════════════════════════════════════════════════════
#  OmliveStream — Backend Production Environment
#  Set these in Render → your service → Environment
#  Values marked <FILL IN> are secrets; never commit real ones.
# ════════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# ── URLs ────────────────────────────────────────────────────────────
API_BASE_URL=https://api.omlivestream.com

# Canonical marketing site. Base for links in transactional emails.
FRONTEND_URL=https://www.omlivestream.com

# Per-surface subdomains.
DASHBOARD_URL=https://dashboard.omlivestream.com
ADMIN_URL=https://admin.omlivestream.com
PAYMENT_URL=https://payment.omlivestream.com

# ── CORS ────────────────────────────────────────────────────────────
# Comma-separated, NO trailing slashes, NO spaces.
# Every subdomain above is added automatically — list here only the
# extra origins: the apex domain, the Vercel deployment URL, and any
# preview domain you want to allow.
CORS_ALLOWED_ORIGINS=https://omlivestream.com,https://www.omlivestream.com,https://om-livestream.vercel.app

# ── Official contact addresses ──────────────────────────────────────
SUPPORT_EMAIL=support@omlivestream.com
SALES_EMAIL=sales@omlivestream.com

# ── Email (Resend) ──────────────────────────────────────────────────
# The sending domain must be verified in Resend before mail will deliver.
RESEND_API_KEY=<FILL IN>
EMAIL_FROM=OmliveStream <noreply@omlivestream.com>

# ── Supabase ────────────────────────────────────────────────────────
SUPABASE_URL=<FILL IN>
SUPABASE_ANON_KEY=<FILL IN>
SUPABASE_SERVICE_ROLE_KEY=<FILL IN>

# ── Secrets (min 32 chars each) ─────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=<FILL IN>
JWT_REFRESH_SECRET=<FILL IN>
ENCRYPTION_KEY=<FILL IN>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Redis (Upstash) ─────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=<FILL IN>
UPSTASH_REDIS_REST_TOKEN=<FILL IN>

# ── Paystack ────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=<FILL IN>
PAYSTACK_PUBLIC_KEY=<FILL IN>
PAYSTACK_WEBHOOK_SECRET=<FILL IN>

# ── OpenAI ──────────────────────────────────────────────────────────
OPENAI_API_KEY=<FILL IN>

# ── mediasoup ───────────────────────────────────────────────────────
# ANNOUNCED_IP must be the server's PUBLIC IP. WebRTC also needs the UDP
# range below to be reachable — Render web services do NOT expose UDP,
# so live streaming requires a VPS. REST/auth/billing work regardless.
MEDIASOUP_ANNOUNCED_IP=<FILL IN — public IP>
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999

# ── RTMP relay (Go service) ─────────────────────────────────────────
RTMP_RELAY_INTERNAL_URL=http://localhost:3002
RTMP_RELAY_SECRET=<FILL IN>

# ── OAuth — redirect URIs must match each provider's console exactly ──
YOUTUBE_CLIENT_ID=<FILL IN>
YOUTUBE_CLIENT_SECRET=<FILL IN>
YOUTUBE_REDIRECT_URI=https://api.omlivestream.com/api/v1/platforms/oauth/callback/youtube

META_APP_ID=<FILL IN>
META_APP_SECRET=<FILL IN>
FACEBOOK_REDIRECT_URI=https://api.omlivestream.com/api/v1/platforms/oauth/callback/facebook
INSTAGRAM_REDIRECT_URI=https://api.omlivestream.com/api/v1/platforms/oauth/callback/instagram

TWITCH_CLIENT_ID=<FILL IN>
TWITCH_CLIENT_SECRET=<FILL IN>
TWITCH_REDIRECT_URI=https://api.omlivestream.com/api/v1/platforms/oauth/callback/twitch

TIKTOK_CLIENT_KEY=<FILL IN>
TIKTOK_CLIENT_SECRET=<FILL IN>
TIKTOK_REDIRECT_URI=https://api.omlivestream.com/api/v1/platforms/oauth/callback/tiktok

TWITTER_CLIENT_ID=<FILL IN>
TWITTER_CLIENT_SECRET=<FILL IN>
TWITTER_REDIRECT_URI=https://api.omlivestream.com/api/v1/platforms/oauth/callback/twitter

LINKEDIN_CLIENT_ID=<FILL IN>
LINKEDIN_CLIENT_SECRET=<FILL IN>
LINKEDIN_REDIRECT_URI=https://api.omlivestream.com/api/v1/platforms/oauth/callback/linkedin

# ── OTP + rate limits ───────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_MS=60000

# ============================================================
# OmliveStream Backend — Environment Variables
# ============================================================
# Copy to .env and fill every value before starting.
# NEVER commit .env to source control.

# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────
# Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── JWT (generate: openssl rand -hex 64) ──────────────────
JWT_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Encryption AES-256 (generate: openssl rand -hex 32) ──
ENCRYPTION_KEY=your_32_byte_hex_key

# ── Resend (email) ────────────────────────────────────────
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=onboarding@resend.dev
SMTP_FROM_NAME=OmliveStream
SMTP_USER=resend
SMTP_PORT=587
SMTP_HOST=smtp.resend.com

# ── Redis (Upstash) ───────────────────────────────────────
# REST (primary — works on any network)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_rest_token
# TCP (optional — only for BullMQ queue processing in production)
# UPSTASH_REDIS_URL=rediss://default:TOKEN@your-instance.upstash.io:6380

# ── Paystack ──────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_your_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_public_key
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret

# ── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your_key

# ── mediasoup WebRTC ──────────────────────────────────────
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999
MEDIASOUP_ANNOUNCED_IP=your.server.public.ip
MEDIASOUP_LISTEN_IP=0.0.0.0

# ── Go RTMP Relay ────────────────────────────────────────
RTMP_RELAY_INTERNAL_URL=http://localhost:3002
RTMP_RELAY_SECRET=your_random_secret

# ── OAuth ────────────────────────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3001/api/v1/platforms/oauth/callback/youtube

META_APP_ID=
META_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3001/api/v1/platforms/oauth/callback/facebook
INSTAGRAM_REDIRECT_URI=http://localhost:3001/api/v1/platforms/oauth/callback/instagram

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3001/api/v1/platforms/oauth/callback/twitch

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3001/api/v1/platforms/oauth/callback/tiktok

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:3001/api/v1/platforms/oauth/callback/twitter

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/api/v1/platforms/oauth/callback/linkedin

# ── App Config ────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_MS=60000

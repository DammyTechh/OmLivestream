<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Camera and microphone: the whole point of the app. -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Outbound network for RTMP push. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!--
      Required to install the Camera Extension in a later phase. Declaring it
      now keeps the signing identity and provisioning profile stable — adding
      it later invalidates both and forces every user to reinstall.
    -->
    <key>com.apple.developer.system-extension.install</key>
    <true/>
</dict>
</plist>

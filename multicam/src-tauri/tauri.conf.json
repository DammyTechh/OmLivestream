{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmliveStream MultiCam",
  "version": "1.0.0",
  "identifier": "com.omlivestream.multicam",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OmliveStream MultiCam",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "theme": null,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.omlivestream.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["bin/*"],
    "copyright": "© 2026 OmliveStream",
    "category": "Video",
    "shortDescription": "Multi-camera mixer for live broadcasting",
    "longDescription": "Mix several cameras, screen shares and images into one professional broadcast. Built for churches, events and organisations streaming to big screens and to every platform at once.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist"
    },
    "linux": {
      "deb": { "depends": [] }
    }
  }
}

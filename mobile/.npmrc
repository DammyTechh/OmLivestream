# Do NOT set engine-strict here.
#
# The previous version of this file turned an `engines` mismatch into a hard
# install failure, which is why `npm install` died on Node 24 before a single
# package was fetched. Expo SDK 54 supports Node 20.19.4+, 22 and 24, so
# there is nothing left to guard against.

# React Native's dependency graph still publishes overlapping peer ranges that
# npm resolves more strictly than the ecosystem actually requires. This keeps
# a clean install from failing on a peer warning that has no runtime effect.
legacy-peer-deps=true
